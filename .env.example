# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Matches docker-compose.yml. Integration tests will use the triage_test database instead.
DATABASE_URL=postgres://triage:triage@localhost:5432/triage
DB_POOL_MAX=10

# Auth. Generate your own secret with: openssl rand -base64 48
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor (4-15). Keep 12 outside of tests.
BCRYPT_COST=12
