# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Matches docker-compose.yml. Integration tests will use the triage_test database instead.
DATABASE_URL=postgres://triage:triage@localhost:5432/triage
DB_POOL_MAX=10
