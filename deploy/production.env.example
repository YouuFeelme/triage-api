# Template for the .env file on the server (~/triage-api/.env). Never commit the real file.
# docs/deploy.md shows how to fill the secrets on the server without them ever appearing on screen.

# Lets a plain `docker compose up -d --build` load both files and the "app" profile.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=app

# Public hostname. Its DNS must point to the server's Elastic IP before the first start.
API_DOMAIN=api.example.com

# Generated on the server: openssl rand -hex 32 (hex only, so it is safe inside DATABASE_URL).
POSTGRES_PASSWORD=
# Generated on the server: openssl rand -base64 48. Different from the one on your Mac.
JWT_SECRET=
