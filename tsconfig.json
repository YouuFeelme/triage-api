{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Output: what Node 24 understands natively */
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Interop and tooling */
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* This config only type-checks (editor, ESLint, `npm run typecheck`).
       Building is done by tsconfig.build.json. */
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "tests"]
}
